{
	// Cloudflare Workers config — static assets only, no server code.
	// Cloudflare's git integration reads this to know what to deploy.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openh2",
	"compatibility_date": "2026-08-23",
	"assets": {
		"directory": "./build",
		"not_found_handling": "404-page"
	}
}
